> ## Interpolation example, for 8 frequencies using NU6 importance
> ## weight, default values for noise.
> sii.left <- sii(
+                 speech="raised",
+                 threshold=c(25,25,30,35,45,45,55,60),
+                 freq=c(250, 500, 1000, 2000, 3000, 4000, 6000, 8000),
+                 method="critical",
+                 importance="NU6",
+                 interpolate=TRUE
+                 )
